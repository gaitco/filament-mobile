{
    "name": "gait/filament-mobile",
    "description": "Serves an existing Laravel Filament panel as a mobile admin JSON contract.",
    "license": "MIT",
    "keywords": ["laravel", "filament", "mobile", "flutter", "admin", "api"],
    "homepage": "https://github.com/gaitco/filament-mobile",
    "support": {
        "issues": "https://github.com/gaitco/filament-mobile/issues",
        "source": "https://github.com/gaitco/filament-mobile"
    },
    "authors": [
        { "name": "Abdullah Ghanem", "email": "info@gaitco.com" }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": { "Gait\\FilamentMobile\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Gait\\FilamentMobile\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Gait\\FilamentMobile\\FilamentMobileServiceProvider"]
        }
    },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable"
}
